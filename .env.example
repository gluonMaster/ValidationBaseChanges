# ========================================
# Environment variables for KindEltern Web
# ========================================
# Copy this file to .env and fill in the values.
# For local development, defaults work out of the box.
# For production (VPS), you MUST set all values explicitly.

# ========================================
# Django Settings
# ========================================

# Secret key for Django cryptographic signing.
# REQUIRED for production! Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# For local development, a default insecure key is used if not set.
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production

# Debug mode: True for development, False for production.
# When False, Django will not show detailed error pages.
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames.
# For local dev: localhost,127.0.0.1
# For production: add your domain, e.g., example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated list of trusted origins for CSRF protection.
# Required for production when using a domain with HTTPS.
# Example: https://example.com,https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Comma-separated list of allowed CORS origins.
# Only needed if frontend is on a different domain.
# Example: https://frontend.example.com
DJANGO_CORS_ALLOWED_ORIGINS=

# ========================================
# PostgreSQL Database Settings
# ========================================

# Database name
POSTGRES_DB=kindeltern

# Database user
POSTGRES_USER=postgres

# Database password
# REQUIRED for production! Use a strong password.
POSTGRES_PASSWORD=your-database-password-here

# Database host
# For local development without Docker: localhost
# When running with docker-compose: db (automatically overridden)
POSTGRES_HOST=localhost

# Database port (default PostgreSQL port)
POSTGRES_PORT=5432

# ========================================
# Legacy Import (Access Database)
# ========================================
# Settings for importing data from Microsoft Access .accdb/.mdb files.
# Used by the legacy_import app (python manage.py import_access_year).

# Directory containing Access database files.
# On Windows: C:\path\to\kindeltern_data
# On Linux/Docker: /opt/kindeltern_data (if using mdbtools)
# ACCESS_BASE_DIR=/opt/kindeltern_data

# ODBC connection string template. The {file_path} placeholder is replaced
# with the full path to the Access file.
# On Windows with Microsoft Access Database Engine (ACE):
#   ACCESS_CONN_STRING_TEMPLATE=DRIVER={{Microsoft Access Driver (*.mdb, *.accdb)}};DBQ={file_path};
# On Linux with MDBTools (limited support):
#   ACCESS_CONN_STRING_TEMPLATE=DRIVER={{MDBTools}};DBQ={file_path};
#
# Важно: фигурные скобки вокруг имени DRIVER должны быть удвоены ({{ ... }}),
# потому что в коде шаблон форматируется через Python `.format(file_path=...)`.
# ACCESS_CONN_STRING_TEMPLATE=DRIVER={{Microsoft Access Driver (*.mdb, *.accdb)}};DBQ={file_path};

# ========================================
# Notes
# ========================================
# - When running with `docker compose up`, POSTGRES_HOST is automatically
#   set to 'db' (the database service name) inside the web container.
# - Never commit the actual .env file with real secrets to version control.
# - For VPS deployment, set DJANGO_DEBUG=False and use strong passwords.
